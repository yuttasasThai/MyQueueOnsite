{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(index.html|sw.js|alarm-sw.js|registerSW.js|manifest.webmanifest)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|api/|sw\\.js|alarm-sw\\.js|workbox-|registerSW\\.js|manifest\\.webmanifest|.*\\.(?:png|jpg|jpeg|svg|ico|webp|js|css|json|webmanifest)$).*)",
      "destination": "/index.html"
    }
  ]
}
